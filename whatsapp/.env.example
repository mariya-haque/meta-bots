# Copy to .env and fill in. Never commit .env.

# --- WhatsApp Cloud API (from Meta App dashboard > WhatsApp > API Setup) ------
# The Phone number ID shown on the API Setup page (a long number, NOT the phone).
WA_PHONE_NUMBER_ID=
# Your WhatsApp business number in international format without "+" (e.g. 15551234567).
# Used for the https://wa.me/c/<number> catalog link.
WA_DISPLAY_PHONE_NUMBER=

# Access token. The temporary token on the API Setup page works for 24h to test.
# For something that keeps running, generate a permanent System User token.
WA_ACCESS_TOKEN=

# App Secret from App dashboard > App settings > Basic (used to verify signatures).
WA_APP_SECRET=

# Any string you invent. You paste this same value into the webhook config form.
WA_VERIFY_TOKEN=

# Optional: Meta Commerce Manager Catalog ID (for showing Catalog Sets directly)
WA_CATALOG_ID=
WA_GRAPH_VERSION=v25.0
WA_HISTORY_TURNS=8
WA_MARK_READ=true
# Log replies instead of sending them
DRY_RUN=false

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# --- SMTP Email Configuration (App Password) -----------------------------------
# Leave SMTP_EMAIL / SMTP_PASSWORD blank to skip confirmation emails.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
