# Copy to .env and fill in. Never commit .env.

# Your Page's numeric ID (Page > About > Page transparency)
FB_PAGE_ID=

# Page Access Token with pages_manage_engagement + pages_read_engagement
# (+ pages_messaging for private replies and Messenger DMs)
FB_PAGE_ACCESS_TOKEN=

# App Secret (App Dashboard > Settings > Basic) - used to verify webhook signatures
FB_APP_SECRET=

# Any random string you invent; paste the same one into the webhook setup form
FB_VERIFY_TOKEN=

OPENAI_API_KEY=

# Optional
FB_GRAPH_VERSION=v23.0
OPENAI_MODEL=gpt-5-nano
REPLY_TO_NESTED=false
# Log the reply instead of posting it. Leave true until the replies look right.
DRY_RUN=true
# Follow each public reply with a private Messenger reply
FB_PRIVATE_REPLY=true
# Text of that private reply. Leave commented out to use the built-in greeting
# (an empty value would send an empty message).
# FB_PRIVATE_REPLY_TEXT=Hi! Thanks for your comment - message us here for details.
# DM turns of history kept per user
FB_DM_HISTORY_TURNS=8
