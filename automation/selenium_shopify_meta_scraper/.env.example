# Meta Graph API Access Token (Optional - if provided, official API is preferred for speed)
META_ACCESS_TOKEN=

# Selenium Settings
HEADLESS_MODE=true

# Default search parameters (informational: the scripts take --country / --max_ads
# on the command line, defaulting to PK and 15 / 100)
DEFAULT_COUNTRY=PK
MAX_ADS_PER_KEYWORD=15
