#
# META AD LIBRARY TO SHOPIFY LEAD EXTRACTOR - CONFIG (.env)
#

# 1. OPTIONAL: Meta Graph API Token (If left blank, the script uses Playwright stealth browser scraping)
META_ACCESS_TOKEN=

# 2. DEFAULT SEARCH SETTINGS (used as defaults for --country / --max_ads)
DEFAULT_COUNTRY=PK
MAX_ADS_PER_KEYWORD=50

# 3. BROWSER SETTINGS
# Set to 'false' if you want to visually see the browser open and scroll on screen during scraping
HEADLESS_MODE=true

# 4. OPTIONAL PROXY (If scraping heavily and want to rotate IPs), e.g. http://user:pass@host:port
PROXY_URL=
